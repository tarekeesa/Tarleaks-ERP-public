# =============================================================================
# Tarleaks ERP — installation settings
#
# ./install.sh (or .\install.ps1) copies this file to .env and fills in every
# value marked GENERATED. You normally never edit it by hand; when you do, run
# `./tarleaks restart` afterwards.
#
# Keep .env private and back it up with your data: the database cannot be read
# back without the keys in it.
# =============================================================================

# ---- Version ---------------------------------------------------------------
# The release to run. `./tarleaks upgrade <version>` changes it for you.
TARLEAKS_VERSION=1.2.0-rc.7
# Where the images come from. Leave as is: the installer and ./tarleaks sign
# Docker in with your licence key (no docker login). Your own mirror instead?
# Put its address here and sign Docker in to it yourself. (No internet? Load
# the offline bundle with ./tarleaks load-bundle.)
TARLEAKS_REGISTRY=registry.tarleaks.com/tarleaks-erp

# ---- Profile: local or production -------------------------------------------
# local       this computer or the office network: http://localhost,
#             http://192.168.1.20. No certificate.
# production  a real domain over HTTPS only (HSTS): https://erp.example.com.
#             docs/https.md
# Chosen by ./install.sh --profile-env local|production (or its question);
# ./install.sh and ./tarleaks doctor refuse settings that do not fit it, such
# as production with an http:// address or an IP address.
TARLEAKS_PROFILE_ENV=local
# production only — who holds the HTTPS certificate:
#   letsencrypt  this gateway, from Let's Encrypt over port 80
#   cloudflare   this gateway, through Cloudflare DNS (needs CF_DNS_API_TOKEN;
#                covers <company>.<host> too)
#   proxy        your own nginx / Caddy / Traefik in front of the ERP
TARLEAKS_TLS=
# Let's Encrypt writes here before a certificate ends (letsencrypt, cloudflare).
ACME_EMAIL=
# Cloudflare API token with Zone, DNS, Edit (cloudflare only). Secret.
CF_DNS_API_TOKEN=
# Run without internet: false, true or sealed. Change it with
# ./tarleaks offline on|sealed|off (docs/offline.md), not by hand.
TARLEAKS_OFFLINE=false

# ---- Address ----------------------------------------------------------------
# The name or IP address people type to reach the ERP, without http://.
#   On this computer only:   localhost
#   On the office network:   192.168.1.20   (this machine's LAN address)
#   On the internet:         erp.example.com (profile production, docs/https.md)
TARLEAKS_HOST=localhost
# The full address, including the port when it is not 80/443.
TARLEAKS_URL=http://localhost
# The port the gateway listens on, and on which network interface.
HTTP_PORT=80
HTTP_BIND=0.0.0.0

# ---- Apps -------------------------------------------------------------------
# The apps you chose. Only these run, plus what they need and the base apps
# (config/apps.tsv says what each app needs). Change them with
#   ./tarleaks apps add payroll      ./tarleaks apps remove crm
#   ./tarleaks profile small|standard|full   (a preset list)
# which also rewrite the two lines below. Do not edit those two by hand.
TARLEAKS_APPS=hr,recruitment,attendance,payroll,accounting,crm,inventory,sales_orders,chat,project_management,lms,gamification,assets,helpdesk,fleet,correspondence,pos,rental,subscriptions,procurement,construction,contracts
COMPOSE_PROFILES=hr,attendance,payroll,accounting,crm,ecommerce,sales_orders,inventory,chat,project_management,lms,gamification,assets,helpdesk,fleet,correspondence,pos,rental,subscriptions,procurement,construction,contracts
TARLEAKS_AVAILABLE_MODULES=notifications,activities,documents,reports,parties,insights,hr,recruitment,attendance,payroll,accounting,crm,ecommerce,sales_orders,inventory,chat,project_management,lms,gamification,assets,helpdesk,fleet,correspondence,pos,rental,subscriptions,procurement,construction,contracts
# The editors: the document editor (New and Edit in Documents), the diagram
# editor and the engine of AI drawing. on or off (about 2 GB of memory).
# Change it with ./tarleaks editors on|off, which also adds or removes their
# names at the end of COMPOSE_PROFILES. (docs/configuration.md#editors)
TARLEAKS_EDITORS=on
# Where the editors answer: written by the installer and ./tarleaks from the
# address above. Do not edit these three by hand.
TARLEAKS_ONLYOFFICE_URL=
# Set by the installer for a release older than 1.2.0 (stock document editor).
# Empty = the release's own image. Your own choice goes in ONLYOFFICE_IMAGE.
TARLEAKS_ONLYOFFICE_IMAGE=
TARLEAKS_DRAWIO_URL=

# ---- Licence ----------------------------------------------------------------
# Typed into the setup screen the first time you open the ERP. GENERATED.
TARLEAKS_SETUP_CODE=GENERATED
# Optional: a licence key from Tarleaks (./install.sh --licence-key). It is
# also the password for downloading the images. Leave empty to enter it on
# the setup screen instead.
TARLEAKS_LICENSE_KEY=
# Written by ./install.sh --trial: the free trial it started, used only to
# download the images until the installation holds its own licence. Choose the
# free trial on the setup screen with the same e-mail address to continue it.
TARLEAKS_DOWNLOAD_KEY=

# ---- File storage -----------------------------------------------------------
# Documents and attachments go to the bundled store (the `files` volume).
# To use AWS S3, Cloudflare R2, Wasabi or a NAS instead, see
# docs/configuration.md#file-storage.
STORAGE_BUCKET=tarleaks-files
STORAGE_ACCESS_KEY=GENERATED
STORAGE_SECRET_KEY=GENERATED
STORAGE_REGION=us-east-1
# TARLEAKS_STORAGE_PROVIDER=s3
# TARLEAKS_STORAGE_ENDPOINT=https://s3.eu-central-1.amazonaws.com
# TARLEAKS_STORAGE_PRESIGN_ENDPOINT=https://s3.eu-central-1.amazonaws.com

# ---- Database and message queue (internal; never exposed) -------------------
POSTGRES_USER=tarleaks
POSTGRES_DB=tarleaks
POSTGRES_PASSWORD=GENERATED
RABBITMQ_USER=tarleaks
RABBITMQ_PASSWORD=GENERATED
# Database tuning. The installer sets these for the chosen profile.
PG_MAX_CONNECTIONS=300
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=1GB
# Memory limit of the database container, for example 2048m (empty: the
# installer sets a quarter of Docker's memory). Other limits
# and the query time limits: docs/configuration.md#memory-limits
PG_MEM_LIMIT=
#PG_STATEMENT_TIMEOUT=300s
#PG_IDLE_IN_TRANSACTION_TIMEOUT=60s
#SERVICE_MEM_LIMIT=1g

# ---- Keys (GENERATED — never change them after the first start) -------------
JWT_SECRET=GENERATED
CLUSTER_DSN_KEY=GENERATED
INTERNAL_TOKEN=GENERATED
PORTAL_JWT_SECRET=GENERATED
NOTIFICATIONS_KEK=GENERATED
NOTIFICATIONS_UNSUB_SECRET=GENERATED
NOTIFICATIONS_OAUTH_SECRET=GENERATED
HELPDESK_TOKEN_KEY=GENERATED
SUBSCRIPTIONS_KEY_SEAL_KEY=GENERATED
MARKETPLACE_TOKEN_KEY=GENERATED
INSIGHTS_SOURCE_KEY=GENERATED
# Keys how visitors of shared dashboard links are recorded (not traceable back).
INSIGHTS_VISITOR_HASH_KEY=GENERATED
# Seals supplier bids until the opening. Back it up outside this server: without
# it, sealed bids of RFQs not yet opened cannot be opened.
PROCUREMENT_KEK=GENERATED
# Seals identity-provider (UAE PASS, Nafath) secrets saved in a workspace for
# contract signing. Back it up outside this server: without it, those saved
# secrets must be entered again.
CONTRACTS_PROVIDER_KEY=GENERATED
# Signs the Accept and Decline links in meeting invitations.
ACTIVITIES_INVITE_SECRET=GENERATED
# Seals the passwords of the mailboxes Correspondence reads incoming mail from.
CORRESPONDENCE_MAILBOX_KEY=GENERATED
# Seals the passwords and sign-in codes of mailboxes connected in CRM.
CRM_EMAIL_TOKEN_KEY=GENERATED
# Seals e-invoicing credentials (ZATCA units, providers). Back it up outside this
# server: without it, e-invoicing must be connected again.
EINVOICE_SEAL_KEY=GENERATED
# Seals the signing certificates (and their passwords) saved in PDF Tools.
PDFTOOLS_SIGN_KEY=GENERATED
# The shared sealing key: saved connection credentials in every app (Finance's
# FTA connection, Settings > Integrations, signing certificates' passphrases in
# Correspondence). Back it up outside this server: never change it.
SOCIAL_TOKEN_KEY=GENERATED
# Seals the single sign-on (Microsoft Entra) client secrets a workspace saves.
SSO_CREDENTIAL_KEY=GENERATED
ONLYOFFICE_JWT_SECRET=GENERATED
# The sign-in token key (Ed25519): its name, its private half (auth alone reads
# it) and its public half for every service. Made by the installer; two-step
# confirmation (sealed tenders) needs it. Never change them by hand: a new key
# signs everyone out, and the private half also protects the keys workspaces use
# to let people sign in to other apps. Empty: tokens are signed with
# JWT_SECRET, as before.
JWT_SIGNING_KID=
JWT_SIGNING_KEY_DER=
JWT_PUBLIC_KEYS=
# The apps' own signing keys (Ed25519, private half): learning certificates and
# passport links (LMS), Open Badges (Gamification). Made by the installer; never
# change them: what was issued before would fail its check. Empty: those two
# are not issued.
LMS_PASSPORT_SIGNING_KEY_DER=
BADGE_SIGNING_KEY_DER=

# ---- Optional: AI features --------------------------------------------------
# Each workspace can also set its own AI provider and key in Settings → AI.
GROQ_API_KEY=
OLLAMA_API_KEY=
OLLAMA_BASE_URL=

# ---- Optional: where the editors are reached ----------------------------------
# Only when people reach the ERP at another address than TARLEAKS_URL (a reverse
# proxy with its own name). Leave empty otherwise: the installer fills the
# editors' addresses (TARLEAKS_ONLYOFFICE_URL, TARLEAKS_DRAWIO_URL) from the
# address above. The editors must be reachable at <address>/onlyoffice/ and
# <address>/drawio/ (docs/configuration.md#editors).
ONLYOFFICE_PUBLIC_URL=
DRAWIO_URL=

# ---- Optional: outbound proxy -----------------------------------------------
# Only when this network lets servers out through a proxy. Empty = connect
# directly. NO_PROXY adds hosts that must NOT go through it (a mail relay, a
# NAS, 192.168.0.0/16); the ERP's own services are always excluded.
# docs/configuration.md#outbound-proxy
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=

# ---- Other ------------------------------------------------------------------
# Time zone of the servers' logs and scheduled jobs (the workspace has its own).
TZ=UTC
# info, warn or debug.
LOG_LEVEL=info
# Scheduled jobs (docs/configuration.md#scheduled-jobs): seconds before the
# first run after a start, and the longest one run may take.
#JOBS_START_DELAY=120
#JOBS_TIMEOUT=3600
