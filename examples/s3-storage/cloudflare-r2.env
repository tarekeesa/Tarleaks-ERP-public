# Cloudflare R2. Put these lines in .env BEFORE the first setup, replacing the
# matching lines. The account ID is the 32 letters and digits on the R2 overview page.
TARLEAKS_STORAGE_PROVIDER=r2
TARLEAKS_STORAGE_ENDPOINT=https://0123456789abcdef0123456789abcdef.r2.cloudflarestorage.com
TARLEAKS_STORAGE_PRESIGN_ENDPOINT=https://0123456789abcdef0123456789abcdef.r2.cloudflarestorage.com
STORAGE_BUCKET=my-company-erp-files
STORAGE_ACCESS_KEY=replace-with-the-r2-access-key-id
STORAGE_SECRET_KEY=replace-with-the-r2-secret-access-key
STORAGE_REGION=auto
