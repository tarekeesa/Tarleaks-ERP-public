# Your own NAS, running the versitygw S3 gateway on the shared folder.
# Put these lines in .env BEFORE the first setup, replacing the matching lines.
# Use the NAS's real network address or name (never localhost). If the ERP is
# served over https://, the NAS address must be https:// too.
TARLEAKS_STORAGE_PROVIDER=nas_versitygw
TARLEAKS_STORAGE_ENDPOINT=http://192.168.1.50:7070
TARLEAKS_STORAGE_PRESIGN_ENDPOINT=http://192.168.1.50:7070
STORAGE_BUCKET=erp-documents
STORAGE_ACCESS_KEY=the-ROOT_ACCESS_KEY-you-gave-versitygw
STORAGE_SECRET_KEY=the-ROOT_SECRET_KEY-you-gave-versitygw
STORAGE_REGION=us-east-1
