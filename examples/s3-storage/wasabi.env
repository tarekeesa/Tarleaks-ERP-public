# Wasabi. Put these lines in .env BEFORE the first setup, replacing the matching
# lines. Use the bucket's region in the endpoints and in STORAGE_REGION.
TARLEAKS_STORAGE_PROVIDER=wasabi
TARLEAKS_STORAGE_ENDPOINT=https://s3.eu-central-1.wasabisys.com
TARLEAKS_STORAGE_PRESIGN_ENDPOINT=https://s3.eu-central-1.wasabisys.com
STORAGE_BUCKET=my-company-erp-files
STORAGE_ACCESS_KEY=replace-with-the-wasabi-access-key
STORAGE_SECRET_KEY=replace-with-the-wasabi-secret-key
STORAGE_REGION=eu-central-1
