# Copy this file to  %UserProfile%\.wslconfig  (for example C:\Users\you\.wslconfig).
# It limits the memory and CPUs the WSL 2 engine behind Docker Desktop may use.
# Apply it: run  wsl --shutdown  in PowerShell, then start Docker Desktop again.
#
# memory   should be at least what your profile needs (small 4 GB, standard 8 GB,
#          full 16 GB), and leave about 2 GB for Windows itself.
# The installer picks the profile from the memory Docker can use, so set this first.
[wsl2]
memory=8GB
processors=4
swap=2GB
# Many apps (more than about 60 containers): give the gateway room to watch its
# route files, or it can start with no routes and answer 404 everywhere.
# Run  wsl --update  first; afterwards .\tarleaks.ps1 doctor shows the limit in
# force on its Gateway line ("inotify instances allowed: 1024").
# kernelCommandLine = sysctl.fs.inotify.max_user_instances=1024
