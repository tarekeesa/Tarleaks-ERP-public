      esac
    fi
    echo "${B}Clock${N}"
    remote=""
    [ "$offline" != false ] || remote=$(curl -fsSI --max-time 10 ${hp:+--proxy "$hp"} https://tarleaks.com 2>/dev/null | awk -F': ' 'tolower($1)=="date" {print $2}' | tr -d '\r')
    if [ -n "$remote" ] && command -v python3 >/dev/null 2>&1; then
      skew=$(python3 -c "import sys,email.utils,time; print(int(abs(time.time()-email.utils.parsedate_to_datetime(sys.argv[1]).timestamp())))" "$remote")
      if [ "$skew" -gt 600 ]; then flag "This machine's clock is ${skew}s off. Enable automatic time (NTP): the licence refuses a clock that runs behind."; else ok "Clock is correct (±${skew}s)"; fi
    elif [ "$offline" != false ]; then
      ok "Not checked: offline. Keep this machine's clock on your own time server (docs/offline.md)"
    else
      warn "Not checked (tarleaks.com did not answer, or python3 is missing)."
    fi
    # The gateway reads its routes through a file watch (inotify). A machine
    # out of inotify instances (fs.inotify.max_user_instances, shared by every
    # container that runs as root) starts it with NO routes: every page 404s.
    echo "${B}Gateway${N}"
    gw_log=""
    if is_running gateway; then
      gw_since=$(docker inspect -f '{{.State.StartedAt}}' "$(docker compose ps -q gateway 2>/dev/null | head -1)" 2>/dev/null || true)
      [ -z "$gw_since" ] || gw_log=$(docker compose logs --no-color --since "$gw_since" gateway 2>/dev/null || true)
    fi
    if ! is_running gateway; then
      warn "The gateway is not running, so nobody can open the ERP. See why: ./tarleaks logs gateway"
    elif printf '%s\n' "$gw_log" | grep -iE 'cannot start the provider \*file|inotify' >/dev/null; then
      flag "The gateway started without its routes (\"couldn't initialize inotify: too many open files\"), so every page answers 404. Raise the limit (Linux: echo fs.inotify.max_user_instances=1024 | sudo tee /etc/sysctl.d/60-tarleaks-inotify.conf && sudo sysctl --system), then ./tarleaks restart. docs/troubleshooting.md"
    else
      inotify=""
      [ -r /proc/sys/fs/inotify/max_user_instances ] && inotify=$(cat /proc/sys/fs/inotify/max_user_instances)
      [ -n "$inotify" ] || inotify=$(docker compose exec -T gateway cat /proc/sys/fs/inotify/max_user_instances 2>/dev/null | tr -d '\r' || true)
      ncont=$(docker ps -q 2>/dev/null | wc -l | tr -d ' ')
      if [ -n "$inotify" ] && [ "$inotify" -le 128 ] 2>/dev/null && [ "${ncont:-0}" -gt 60 ]; then
        warn "This machine allows only $inotify inotify instances and runs $ncont containers: at the next restart the gateway may start without its routes (every page 404). Raise it: echo fs.inotify.max_user_instances=1024 | sudo tee /etc/sysctl.d/60-tarleaks-inotify.conf && sudo sysctl --system"
      else
        ok "The gateway started with its routes${inotify:+ (inotify instances allowed: $inotify)}"
      fi
    fi
    echo "${B}Disk${N}"
    root=$(docker info --format '{{.DockerRootDir}}' 2>/dev/null)
    if [ -n "$root" ] && [ -d "$root" ]; then
      avail_kb=$(df -Pk "$root" 2>/dev/null | awk 'NR==2 {print $4}')
      where="where Docker keeps images and data ($root)"
    else
      avail_kb=$(df -Pk . | awk 'NR==2 {print $4}')
      where="for this folder (Docker Desktop keeps its data in its own disk image: Settings, Resources)"
    fi
    if [ -n "$avail_kb" ] && [ "$avail_kb" -lt 5242880 ]; then
      flag "Only $((avail_kb / 1024 / 1024)) GB free $where. Below 5 GB the database can stop. Free space: docker image prune; move old backups off the machine."
    elif [ -n "$avail_kb" ]; then ok "$((avail_kb / 1024 / 1024)) GB free $where"; fi
    echo
    "$0" status
    echo
    if [ "$problems" -gt 0 ]; then bad "$problems problem(s) found (✗ above)."; exit 1; fi
    ok "No problems found." ;;
  uninstall)
    case "${1:-}" in ''|--purge) ;; *) die "usage: ./tarleaks uninstall [--purge]" ;; esac
    if [ "${1:-}" = --purge ]; then
      printf 'This DELETES all data in Docker (database, files, queues). Type DELETE to continue: '
      read -r answer || true; [ "$answer" = DELETE ] || die "Cancelled."
      stop_all
      ids=$(project_containers)
      [ -z "$ids" ] || printf '%s\n' "$ids" | xargs docker rm -f >/dev/null
      docker compose down -v --remove-orphans
      ok "Removed the containers and the data volumes (database, files, queues)."
      nb=0; [ -d backups ] && nb=$(find backups -mindepth 1 -maxdepth 1 -type d | wc -l | tr -d ' ')
      echo "${B}Still on this machine (not deleted):${N}"
      [ "$nb" = 0 ] || echo "  backups/      $nb backup(s): each is a full, readable copy of the database plus your keys"
      echo "  .env          the passwords and keys of this installation$([ -f .env.before-restore ] && printf ' (and .env.before-restore)')"
      echo "  the images    about $(docker compose config --images 2>/dev/null | sort -u | xargs docker image inspect --format '{{.Size}}' 2>/dev/null | awk '{s+=$1} END {printf "%.1f", s/1073741824}') GB of programs (no data)"
      echo "To remove those too (from this folder):"
      echo "  rm -rf backups .env .env.before-restore"
      echo "  docker image prune -a      (removes every image no container uses, not only Tarleaks')"
      echo "Then delete this folder."
    else
      stop_all
      ids=$(project_containers)
      [ -z "$ids" ] || printf '%s\n' "$ids" | xargs docker rm -f >/dev/null
      docker compose down --remove-orphans
      ok "Removed the containers. Your data is kept in Docker volumes (./tarleaks start brings everything back; ./tarleaks uninstall --purge deletes the data)."
    fi ;;
  help|-h|--help)
    sed -n '2,/^# ====/p' "$0" | grep -v '^# ====' | sed 's/^# \{0,1\}//' ;;
  *)
    sed -n '2,/^# ====/p' "$0" | grep -v '^# ====' | sed 's/^# \{0,1\}//' >&2
    bad "Unknown command: $cmd (the list is above)" >&2
    exit 2 ;;
esac
